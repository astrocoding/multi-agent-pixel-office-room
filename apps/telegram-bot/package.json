{
  "name": "telegram-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -b",
    "start": "node dist/main.js",
    "test": "tsx --test tests/**/*.test.ts",
    "test:integration": "tsx --test tests/integration/**/*.test.ts",
    "test:security": "tsx --test tests/security/**/*.test.ts",
    "webhook:info": "tsx src/cli/webhookCli.ts info",
    "webhook:set": "tsx src/cli/webhookCli.ts set"
  },
  "dependencies": {
    "@agent-office/shared": "workspace:*",
    "@fastify/cors": "^11.4.3",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.11.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}

