{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@agent-office/shared": ["../../packages/shared/src/index.ts"],
      "@agent-office/game-core": ["../../packages/game-core/src/index.ts"]
    }
  },
  "include": ["src"]
}
