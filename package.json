{
  "name": "agent-office-room",
  "version": "1.0.0",
  "description": "2D Pixel Office Room Simulation for Multi-Agent AI Runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "telegram:dev": "pnpm --filter telegram-bot dev",
    "telegram:build": "pnpm --filter telegram-bot build",
    "telegram:test": "pnpm --filter telegram-bot test",
    "telegram:test:integration": "pnpm --filter telegram-bot test:integration",
    "telegram:test:security": "pnpm --filter telegram-bot test:security",
    "telegram:webhook:info": "pnpm --filter telegram-bot webhook:info",
    "telegram:webhook:set": "pnpm --filter telegram-bot webhook:set"
  },
  "packageManager": "pnpm@11.28.13",
  "devDependencies": {
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@google/adk": "^2.5.0"
  }
}
